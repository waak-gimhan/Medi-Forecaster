# =============================================================
# Pharmacy Demand Forecasting — Environment Variables
# =============================================================
# Copy this file to ".env" and fill in your values.
#   cp .env.example .env
#
# The .env file is listed in .gitignore and will NOT be committed.
# =============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=pharmacy_demand
POSTGRES_USER=pharmacy_user
POSTGRES_PASSWORD=pharmacy_pass

# ── Backend ───────────────────────────────────────────────────
# Constructed automatically in docker-compose.yml.
# Override here only if deploying outside Docker Compose.
# DATABASE_URL=postgresql://pharmacy_user:pharmacy_pass@postgres:5432/pharmacy_demand

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
